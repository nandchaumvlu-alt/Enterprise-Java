<!DOCTYPE html>
<html>
    <head>
        <title>Employee Update</title>
    </head>
    <body>
        <h2>Update Employee</h2>
        <form action="update.jsp" method="post">
            Employee No:
            <input type="text" name="eno"><br><br>
            Name:
            <input type="text" name="name"><br><br>
            Age:
            <input type="text" name="age"><br><br>
            Designation:
            <input type="text" name="designation"><br><br>
            Salary:
            <input type="text" name="salary"><br><br>
            <input type="submit" value="Update">
        </form>
    </body>
</html>
Display.jsp:-
<%@page import="java.sql.*"%>
<%
    String eno = request.getParameter("eno");
    String name = request.getParameter("name");
    String age = request.getParameter("age");
    String des = request.getParameter("designation");
    String salary = request.getParameter("salary");
    try {
        Class.forName("com.mysql.jdbc.Driver");
        Connection con = DriverManager.getConnection(
                "jdbc:mysql://localhost:3306/company",
                "root",
                "root"
        );
        PreparedStatement ps = con.prepareStatement(
               "UPDATE employee SET name=?, age=?, designation=?, salary=? WHERE eno=?");
        ps.setString(1, name);
        ps.setInt(2, Integer.parseInt(age));
        ps.setString(3, des);
        ps.setDouble(4, Double.parseDouble(salary));
        ps.setInt(5, Integer.parseInt(eno));
        int i = ps.executeUpdate();
        if (i > 0) {
            out.println("<h2>Record Updated Successfully</h2>");
        } else {
            out.println("<h2>Employee Not Found</h2>");
        }
        con.close();
    } catch (Exception e) {
        out.println(e);
    }
%>
